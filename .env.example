# ==============================================================================
# OrganLink Environment Variables
# ==============================================================================
# Retrieve these values from your Supabase Project Dashboard:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project (or create a new one)
# 3. Navigate to Project Settings -> API
# 4. Copy "Project URL" and paste into NEXT_PUBLIC_SUPABASE_URL
# 5. Copy "anon public" Project API key and paste into NEXT_PUBLIC_SUPABASE_ANON_KEY

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

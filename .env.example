# ==============================================================================
# OrganLink Environment Variables (Production & Local Development)
# ==============================================================================
# Retrieve these values from your Supabase Project Dashboard:
# https://supabase.com/dashboard -> Project Settings -> API
#
# DO NOT COMMIT REAL SECRETS OR SERVICE ROLE KEYS TO GIT REPOSITORIES.

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Exposed to browser via Next.js bundle)
# ------------------------------------------------------------------------------
# Supabase Project HTTPS URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon / Public API Key (Enforces Row-Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY VARIABLES (NEVER expose to browser / client code)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses Row-Level Security for administrative scripts)
# CAUTION: Never prefix with NEXT_PUBLIC_ and never use in Client Components!
SUPABASE_SERVICE_ROLE_KEY=
